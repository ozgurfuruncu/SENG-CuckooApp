{
  "name": "cuckoo-sprint-2-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "node --test tests/model.test.ts tests/docs.test.ts",
    "test:browser": "node scripts/run-browser.mjs",
    "test:diagrams": "node scripts/validate-diagrams.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.11.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "mermaid": "11.12.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "8.3.5",
    "yaml": "2.8.1"
  }
}
